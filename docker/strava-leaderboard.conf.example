# Strava Club Leaderboard — Docker config template
# Copy to a local file, fill in your credentials, then mount it:
#
#   cp docker/strava-leaderboard.conf.example leaderboard.conf
#   docker run ... -v ./leaderboard.conf:/etc/strava-leaderboard.conf:ro ...
#
# The leaderboard scrapes Strava's web club feed with your browser session cookie
# (the Club Activities API was removed by Strava).

# --- Session cookie (copy _strava4_session from browser DevTools; lasts ~30 days) ---
STRAVA_SESSION_COOKIE=""

# --- Club IDs (comma-separated numeric IDs from the Strava club URL) ---
STRAVA_CLUB_IDS=""

# --- Paths (pre-set for the /data volume in docker-compose.yml) ---
STRAVA_STATE_DIR="/data/strava-leaderboard"
STRAVA_WEB_DIR="/www/strava"

# --- Retention ---
STRAVA_KEEP_SNAPSHOTS="90"

# --- Email notifications (optional — leave blank to disable) ---
# STRAVA_EMAIL_SMTP="smtp.gmail.com:587"
# STRAVA_EMAIL_USER=""
# STRAVA_EMAIL_FROM=""
# STRAVA_EMAIL_TO=""
# STRAVA_EMAIL_WEEKLY_TO=""
# STRAVA_EMAIL_ALERTS_TO=""
